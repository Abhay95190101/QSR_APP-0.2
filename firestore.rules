rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || (resource != null && resource.data.uid == request.auth.uid));
    }

    // User Profile Entity Validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'uid', 'displayName', 'role', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 64 &&
        data.uid is string && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 128 &&
        data.role in ['owner', 'manager', 'kitchen', 'customer'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32)) &&
        (!('phoneVerified' in data) || data.phoneVerified is bool) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Users Collection Rule
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        resource.data.uid == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['emailVerified', 'phoneVerified', 'displayName', 'phoneNumber', 'avatarUrl', 'updatedAt'])
      );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Orders Collection Rule
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() || true;
      allow delete: if isSignedIn();
    }
  }
}
